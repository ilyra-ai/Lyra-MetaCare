# =============================================================================
# Lyra MetaCare · modelo de configuração (.env.example)
# =============================================================================
# Este arquivo é a documentação versionada das variáveis do projeto e NÃO
# contém segredos. A configuração real fica em `.env.local` (ignorado pelo Git)
# e é a fonte única usada por Next.js, scripts do banco, Docker Compose e
# launchers.
#
# Para criar ou completar o `.env.local`:
#   pnpm env:init
#
# O comando copia os valores padrão abaixo, gera os segredos marcados como
# "gerado automaticamente" com aleatoriedade criptográfica, nunca sobrescreve
# valores existentes e grava o arquivo com permissão 0600.
#
# O Docker Compose lê este mesmo arquivo: `docker compose --env-file .env.local`
# (os scripts `pnpm db:*` e os launchers já fazem isso).

# -----------------------------------------------------------------------------
# Banco de dados (MySQL 9.7 LTS via Docker Compose)
# -----------------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
# Porta publicada no host (compose.yaml) e porta usada pela aplicação.
MYSQL_HOST_PORT=3307
MYSQL_PORT=3307
MYSQL_DATABASE=lyra_metacare
MYSQL_USER=lyra
# Senha do usuário da aplicação. Gerado automaticamente.
MYSQL_PASSWORD=
# Senha do root do MySQL (usada só pelo container e por `pnpm db:upgrade`).
# Gerado automaticamente.
MYSQL_ROOT_PASSWORD=

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
# Chave HS256 das sessões (mínimo de 32 bytes). Gerado automaticamente.
AUTH_SECRET=

# Administrador criado ou atualizado por `pnpm db:migrate`.
ADMIN_BOOTSTRAP_EMAIL=admin@lyra.local
# Gerado automaticamente; consulte o valor no seu `.env.local`.
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FIRST_NAME=Admin
ADMIN_BOOTSTRAP_LAST_NAME=Lyra
# Opcional: administradores extras em JSON, por exemplo
# '[{"email":"ana@exemplo.com","password":"<senha forte>","firstName":"Ana","lastName":"Souza"}]'
ADMIN_BOOTSTRAP_ADDITIONAL_ADMINS=

# -----------------------------------------------------------------------------
# URLs da aplicação (retornos do Stripe e links absolutos)
# -----------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Opcional · IA externa (Google AI Studio). Sem chave, a Lyra usa os motores
# determinísticos locais e o modo BYOK do chat.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Opcional · Stripe (checkout, portal e webhooks). Use chaves de teste
# (sk_test_...) em desenvolvimento; sem elas, o billing externo fica
# desativado e a API responde 503 de forma explícita.
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDs de preço por plano pago (STRIPE_PRICE_<PLANO>_<MONTHLY|ANNUAL>); também
# podem ser definidos por plano na área administrativa.
STRIPE_PRICE_META_MONTHLY=
STRIPE_PRICE_META_ANNUAL=
STRIPE_PRICE_CARE_MONTHLY=
STRIPE_PRICE_CARE_ANNUAL=

# -----------------------------------------------------------------------------
# Opcional · Armazenamento de imagens (avatares). Vazio = pasta storage/ do
# projeto; em produção, aponte para um volume persistente (caminho absoluto).
# -----------------------------------------------------------------------------
LYRA_STORAGE_DIR=

# -----------------------------------------------------------------------------
# Opcional · Sentry. Sem DSN, o SDK não envia eventos; a coleta de dados
# pessoais e de saúde vem desligada no código.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=
# Apenas para upload de source maps no build.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Opcional · desenvolvimento
# -----------------------------------------------------------------------------
# `true` registra o loader do Dyad no `pnpm dev:webpack`.
ENABLE_DYAD_COMPONENT_TAGGER=
