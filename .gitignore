# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/dist/
/.turbo/

# production
/build
/storage
/output/
/\.playwright-cli/
/playwright-report/
/test-results/

# misc
.DS_Store
__pycache__/
venv/
*.bak.*
*.pem
*.seed
*.pid
*.pid.lock
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*
.lyra-run/
# Estado da versão anterior do run_windows.py (detectado e sinalizado por ele).
.lyra-run-windows/
.logs/
/backups/mysql/

# Arquivos de ambiente: todos contêm configuração local e segredos, exceto o
# modelo documentado .env.example (sem valores secretos).
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
