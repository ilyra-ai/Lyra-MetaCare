{
  "name": "lyra-metacare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:launchers": "python3 -m unittest discover -s tests/launchers -p \"test_*.py\" -v",
    "fix:format": "prettier --write .",
    "fix:lint": "eslint . --fix",
    "check:lint": "eslint .",
    "check:format": "prettier --check .",
    "check:types": "tsc --noEmit",
    "env:init": "node scripts/env-init.mjs",
    "db:start": "pnpm run env:init && docker compose --env-file .env.local up -d --wait mysql && pnpm run db:migrate",
    "db:migrate": "node scripts/mysql-migrate.mjs",
    "db:upgrade": "node scripts/mysql-upgrade.mjs",
    "db:backup": "node scripts/mysql-upgrade.mjs --backup",
    "db:restore": "node scripts/mysql-upgrade.mjs --restaurar",
    "db:stop": "docker compose --env-file .env.local down",
    "db:logs": "docker compose --env-file .env.local logs -f mysql",
    "lyra-customaze:install": "python3 implement_elementor_lyra.py"
  },
